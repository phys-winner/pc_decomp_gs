<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.griefsyndrome.port"
    android:versionCode="4"
    android:versionName="1.0">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="37" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <!-- launcher:manifest -->
    <application
        android:allowBackup="false"
        android:appCategory="game"
        android:isGame="true"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:requestLegacyExternalStorage="true"
        android:resizeableActivity="true"
        android:theme="@style/PortTheme">
        <meta-data android:name="notch.config" android:value="portrait|landscape" />
        <!-- launcher:application -->
        <activity
            android:name=".GameActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode"
            android:exported="true"
            android:process=":game"
            android:screenOrientation="sensorLandscape" />
    </application>
</manifest>
