-EMIT_GLSL_OPCODE_UNIMPLEMENTED_FUNC(TEXCRD)
+// SM 1.4 exposes a three-component selector (.xyz or .xyw), plus an
+// optional projective divide. General ALU source modifiers do not apply.
+static void make_GLSL_ps14_texcoord(Context *ctx, const int dims,
+                                   char *buf, const size_t buflen)
+{
+    const SourceArgInfo *src = &ctx->source_args[0];
+    char var[64]; get_GLSL_srcarg_varname(ctx, 0, var, sizeof (var));
+    if ((src->swizzle_x != 0) || (src->swizzle_y != 1) ||
+        ((src->swizzle_z != 2) && (src->swizzle_z != 3)))
+    {
+        fail(ctx, "ps_1_4 texture selector must be .xyz or .xyw");
+        *buf = '\0';
+        return;
+    } // if
+
+    if (src->src_mod == SRCMOD_NONE)
+        make_GLSL_srcarg_string(ctx, 0, (1 << dims) - 1, buf, buflen);
+    else if ((dims == 2) &&
+             (((src->src_mod == SRCMOD_DW) && (src->regtype == REG_TYPE_TEXTURE) && (src->swizzle_z == 3)) ||
+              ((src->src_mod == SRCMOD_DZ) && (src->regtype == REG_TYPE_TEMP) && (src->swizzle_z == 2))))
+        snprintf(buf, buflen, "(%s.xy / %s.%c)", var, var,
+                 (src->src_mod == SRCMOD_DW) ? 'w' : 'z');
+    else
+    {
+        fail(ctx, "invalid ps_1_4 texture projection or source modifier");
+        *buf = '\0';
+    } // else
+} // make_GLSL_ps14_texcoord
+
+void emit_GLSL_TEXCRD(Context *ctx)
+{
+    char code[256];
+    if (!shader_version_atleast(ctx, 1, 4))
+    {
+        char input[64];
+        const int regnum = ctx->dest_arg.regnum;
+#if SUPPORT_PROFILE_GLSLES
+        const int skipGLTexCoord = support_glsles(ctx) || (regnum >= 4);
+#else
+        const int skipGLTexCoord = (regnum >= 4);
+#endif
+        if (skipGLTexCoord)
+            snprintf(input, sizeof (input), "io_%i_%i", MOJOSHADER_USAGE_TEXCOORD, regnum);
+        else
+            snprintf(input, sizeof (input), "gl_TexCoord[%d]", regnum);
+        make_GLSL_destarg_assign(ctx, code, sizeof (code),
+            "vec4(clamp(%s.xyz, vec3(0.0), vec3(1.0)), 1.0)", input);
+    } // if
+    else
+    {
+        // The undefined components are set to zero. Unlike texcoord, texcrd
+        // preserves signed coordinates and does not saturate to [0, 1].
+        const int projected = ctx->source_args[0].src_mod == SRCMOD_DW;
+        char src[128], mask[6];
+        make_GLSL_ps14_texcoord(ctx, projected ? 2 : 3, src, sizeof (src));
+        make_GLSL_swizzle_string(mask, sizeof (mask), 0xE4, ctx->dest_arg.writemask);
+        make_GLSL_destarg_assign(ctx, code, sizeof (code),
+            projected ? "vec4(%s, 0.0, 0.0)%s" : "vec4(%s, 0.0)%s", src, mask);
+    } // else
+    output_line(ctx, "%s", code);
+} // emit_GLSL_TEXCRD
 
